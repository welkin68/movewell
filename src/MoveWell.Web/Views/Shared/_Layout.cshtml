@{
    var common = Ui.Common;
    var title = ViewData["Title"] as string ?? common["site.name"].Value;
    var description = ViewData["Description"] as string ?? common["site.description"].Value;
    var request = Context.Request;
    var origin = $"{request.Scheme}://{request.Host}";
}
<!DOCTYPE html>
<html lang="@Ui.Language" dir="@Ui.Direction">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#0f766e" />
    <link rel="alternate" hreflang="fa" href="@(origin + CulturePath.For(request, Cultures.Fa))" />
    <link rel="alternate" hreflang="en" href="@(origin + CulturePath.For(request, Cultures.En))" />
    <link rel="alternate" hreflang="x-default" href="@(origin + CulturePath.For(request, Cultures.Fa))" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/vazirmatn/vazirmatn-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/shared/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/components.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script type="module" src="~/js/shared/ui.js" asp-append-version="true"></script>
</head>
<body class="has-bottom-nav">
    <a class="skip-link" href="#main">@common["skip.content"]</a>

    <partial name="Ui/_SiteHeader" />
    <partial name="Ui/_Flash" />

    <main id="main" class="site-main" tabindex="-1">
        @RenderBody()
    </main>

    <partial name="Ui/_SiteFooter" />
    <partial name="Ui/_BottomNav" />
</body>
</html>
