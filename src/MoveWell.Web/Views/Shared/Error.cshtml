@model int?
@{
    var t = Ui.For("public/error/index");
    var notFound = Model == 404;
    ViewData["Title"] = (notFound ? t["404.title"] : t["general.title"]).Value;
}
<div class="container">
    <div class="card card--narrow stack text-center">
        <h1>@(notFound ? t["404.title"] : t["general.title"])</h1>
        <p class="text-muted">@(notFound ? t["404.text"] : t["general.text"])</p>
        <p><a class="btn btn--primary" asp-controller="Home" asp-action="Index" asp-area="">@t["back.home"]</a></p>
    </div>
</div>
