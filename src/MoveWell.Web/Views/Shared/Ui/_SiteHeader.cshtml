@{
    var common = Ui.Common;
    var otherLanguage = Ui.IsEnglish ? Cultures.Fa : Cultures.En;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var controller = ViewContext.RouteData.Values["controller"] as string;
}
<header class="site-header">
    <div class="container site-header__bar">
        <a class="brand" asp-controller="Home" asp-action="Index" asp-area="">
            <img class="brand__mark" src="~/img/brand/mark.svg" alt="" width="32" height="32" />
            <span class="brand__name">@common["site.name"]</span>
        </a>

        <nav class="site-header__nav" aria-label="@common["nav.main"]">
            <a class="nav-link" asp-controller="Home" asp-action="Index" asp-area=""
               aria-current="@(controller == "Home" ? "page" : null)">@common["nav.home"]</a>
        </nav>

        <div class="site-header__actions">
            <a class="nav-link lang-switch" href="@CulturePath.For(Context.Request, otherLanguage)"
               hreflang="@otherLanguage" lang="@otherLanguage" aria-label="@common["lang.switch.label"]">
                <svg class="icon" aria-hidden="true"><use href="@(Url.Content("~/icons/sprite.svg"))#globe" /></svg>
                <span>@common["lang.switch"]</span>
            </a>

            @if (signedIn)
            {
                <a class="user-chip nav-link" asp-controller="Account" asp-action="Index" asp-area="">
                    <svg class="icon" aria-hidden="true"><use href="@(Url.Content("~/icons/sprite.svg"))#user" /></svg>
                    <span class="user-chip__name">@User.Identity!.Name</span>
                </a>
                <form class="inline-form" method="post" asp-controller="Account" asp-action="SignOut" asp-area="">
                    <button type="submit" class="btn btn--ghost btn--sm">
                        <svg class="icon icon--flip-rtl" aria-hidden="true"><use href="@(Url.Content("~/icons/sprite.svg"))#log-out" /></svg>
                        <span>@common["nav.signout"]</span>
                    </button>
                </form>
            }
            else
            {
                <a class="btn btn--primary btn--sm" asp-controller="Account" asp-action="SignIn" asp-area="">@common["nav.signin"]</a>
            }
        </div>
    </div>
</header>
