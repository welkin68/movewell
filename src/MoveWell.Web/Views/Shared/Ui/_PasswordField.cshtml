@model PasswordField
@{
    var sprite = Url.Content("~/icons/sprite.svg");
}
<div class="field">
    <label class="field__label" for="@Model.Id">@Model.Label</label>
    <div class="input-group">
        <input class="input input--ltr" type="password" id="@Model.Id" name="@Model.Name"
               autocomplete="@Model.Autocomplete" required maxlength="128" dir="ltr"
               aria-describedby="@(Model.Hint is null ? null : Model.Id + "-hint")" />
        <button type="button" class="input-group__action" hidden
                data-toggle-password="@Model.Id" aria-pressed="false" aria-label="@Ui.Common["form.show_password"]"
                data-icon-show="@(sprite)#eye" data-icon-hide="@(sprite)#eye-off">
            <svg class="icon" aria-hidden="true"><use href="@(sprite)#eye" /></svg>
        </button>
    </div>
    @if (Model.Hint is not null)
    {
        <p class="field__hint" id="@(Model.Id)-hint">@Model.Hint</p>
    }
</div>
