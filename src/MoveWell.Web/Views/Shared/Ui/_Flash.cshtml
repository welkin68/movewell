@* Toast for a message set before a redirect: TempData["Flash"] = resource key in public/shared/common. *@
@{
    var key = TempData["Flash"] as string;
}
@if (!string.IsNullOrEmpty(key))
{
    <div class="toast" role="status" data-toast>
        <svg class="icon" aria-hidden="true"><use href="@(Url.Content("~/icons/sprite.svg"))#check" /></svg>
        <span>@Ui.Common[key]</span>
        <button type="button" class="toast__close" data-toast-close aria-label="@Ui.Common["toast.close"]">
            <svg class="icon" aria-hidden="true"><use href="@(Url.Content("~/icons/sprite.svg"))#x" /></svg>
        </button>
    </div>
}
