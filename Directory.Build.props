<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Shared NuGet versions for MoveWell projects (lib/CookieBytes.Core has its own props) -->
  <PropertyGroup>
    <EfCoreVersion>10.0.0</EfCoreVersion>
    <AspNetCoreVersion>10.0.0</AspNetCoreVersion>
    <MediatRVersion>12.5.0</MediatRVersion>
    <MediatRContractsVersion>2.0.1</MediatRContractsVersion>
    <FluentValidationVersion>11.11.0</FluentValidationVersion>
    <FluentResultsVersion>3.16.0</FluentResultsVersion>
    <SerilogAspNetCoreVersion>9.0.0</SerilogAspNetCoreVersion>
    <SerilogSinksFileVersion>6.0.0</SerilogSinksFileVersion>
    <SerilogSinksConsoleVersion>6.0.0</SerilogSinksConsoleVersion>
    <HealthChecksEfCoreVersion>10.0.0</HealthChecksEfCoreVersion>
    <NetArchTestVersion>1.3.2</NetArchTestVersion>
  </PropertyGroup>

  <!-- Security pin: Microsoft.Data.SqlClient 6.1.1 and EF Design pull System.Security.Cryptography.Pkcs 9.0.4 (NU1902/NU1903).
       Remove when EF Core / SqlClient ship a fixed transitive version. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
</Project>
